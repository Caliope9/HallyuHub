{
  "framework": null,
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "build/web",
  "redirects": [
    {
      "source": "/beta",
      "destination": "/acceso",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
